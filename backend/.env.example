APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MODEL_PATH=models/plant_disease_model.keras
MODEL_METADATA_PATH=models/model_metadata.json
CLASS_LABELS_PATH=models/class_labels.json
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=12000
MAX_CONCURRENT_ANALYSES=2
MODEL_CONCURRENCY=1
ANALYSIS_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=20
# Optional shared quotas; required when production Gemini is enabled.
REDIS_URL=
RATE_LIMIT_SALT=replace-with-a-random-secret-in-production
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Explicitly choose an image + structured-output capable model for your account.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_DAILY_REQUEST_LIMIT=100
GEMINI_CONCURRENCY=1
# Keep false unless you deliberately configure trusted proxy forwarding.
TRUST_PROXY_HEADERS=false
