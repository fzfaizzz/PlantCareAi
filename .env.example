# Browser uses only the same-origin endpoint. Never put secrets in VITE_ variables.
VITE_ANALYSIS_ENDPOINT=/api/analyze
# Server-only variables: set locally in .env.local, and on Vercel in Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Streamlit: prefer configured Gemini; local-only results remain inconclusive.
PLANTCARE_ANALYSIS_ENGINE=auto
